Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Marker
      Name: New target - RGB triangle mesh
      Enabled: true
      Value: true
      Topic:
        Value: /tef4d/target_mesh
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
    - Class: rviz_default_plugins/Marker
      Name: Saved Gc background - cropped triangle mesh
      Enabled: true
      Value: true
      Topic:
        Value: /tef4d/background_mesh
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
    - Class: rviz_default_plugins/MarkerArray
      Name: Path - accepted green predicted orange
      Enabled: true
      Value: true
      Topic:
        Value: /tef4d/trajectory
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
    - Class: rviz_default_plugins/Marker
      Name: Frame and optimization status
      Enabled: true
      Value: true
      Topic:
        Value: /tef4d/label
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
  Enabled: true
  Global Options:
    Background Color: 18; 23; 30
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Integrated object reconstruction
      Distance: 17
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.65
      Yaw: 2.8
      Near Clip Distance: 0.01
      Target Frame: inspection_view
Window Geometry:
  Width: 1650
  Height: 1000
